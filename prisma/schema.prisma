// Схема Sprint 1: только auth-контур (§7.2–7.4 задачи 01-foundation).
// Игровые модели (Topic, Question, Attempt, Progress, UserStats и т.д.)
// добавляются отдельными миграциями в Sprint 2–4.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

enum IdentityProvider {
  EMAIL
  VK
  OK
  YANDEX
  TELEGRAM
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
}

enum ConsentType {
  TERMS
  PRIVACY
  MARKETING
}

model User {
  id               String    @id @default(cuid())
  email            String
  emailNormalized  String    @unique
  passwordHash     String?
  name             String?
  avatarUrl        String?
  role             UserRole  @default(USER)
  isGuest          Boolean   @default(false)
  emailVerifiedAt  DateTime?
  sessionEpoch     Int       @default(0)
  timezone         String    @default("Europe/Moscow")
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  identities AuthIdentity[]
  tokens     EmailToken[]
  consents   Consent[]
}

model AuthIdentity {
  id                String           @id @default(cuid())
  userId            String
  provider          IdentityProvider
  providerAccountId String
  email             String?
  createdAt         DateTime         @default(now())
  lastUsedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model EmailToken {
  id          String         @id @default(cuid())
  userId      String
  type        EmailTokenType
  tokenHash   String         @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime       @default(now())
  requestedIp String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Consent {
  id        String      @id @default(cuid())
  userId    String?
  type      ConsentType
  version   String
  accepted  Boolean
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, version])
}
