# Окружение приложения: local | test | production.
# Не путать с NODE_ENV: next build и next start всегда выставляют production.
APP_ENV=local

# PostgreSQL из docker-compose.yml. Локальные учётные данные, не секрет.
# DB_PORT — хост-порт; должен совпадать с портом в DATABASE_URL.
DB_PORT=5432
DATABASE_URL=postgresql://quiz:quiz@localhost:5432/quiz?schema=public
# Отдельная БД для integration/e2e (нужна только тестам, локально можно оставить пустой).
DATABASE_URL_TEST=

# Секрет для подписи cookie сессии. Обязателен, минимум 32 символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

APP_URL=http://localhost:3000

AUTH_SESSION_TTL_DAYS=30
AUTH_VERIFY_TOKEN_TTL_HOURS=24
AUTH_RESET_TOKEN_TTL_HOURS=1
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_LOGIN_AFTER_VERIFY=false

AUTH_RL_REGISTER_PER_EMAIL_H=3
AUTH_RL_REGISTER_PER_IP_H=5
AUTH_RL_LOGIN_PER_EMAIL_15M=10
AUTH_RL_LOGIN_PER_IP_15M=10
AUTH_RL_RESEND_PER_EMAIL_H=3
AUTH_RL_RESEND_PER_IP_H=10
AUTH_RL_FORGOT_PER_EMAIL_H=3
AUTH_RL_FORGOT_PER_IP_H=10
AUTH_RL_RESET_PER_IP_H=5
AUTH_RL_CHANGE_PASSWORD_PER_USER_H=5

LEGAL_TERMS_VERSION=2026-11-09-draft
LEGAL_PRIVACY_VERSION=2026-11-09-draft

# log — письма пишутся в logs/dev-mail.log (запрещён при APP_ENV=production).
# smtp — реальная отправка (настраивается перед бетой).
MAIL_TRANSPORT=log
MAIL_FROM="Тесты и квизы <no-reply@localhost>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
